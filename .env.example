# Node server
PORT=3001

# Comma-separated browser origins allowed to use Socket.IO in development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional override for the compiled rules-engine executable.
# DIPLOMACY_ENGINE_PATH=/absolute/path/to/diplomacy-engine

# Optional client override. Leave unset when client and server share an origin.
# VITE_SERVER_URL=http://localhost:3001
