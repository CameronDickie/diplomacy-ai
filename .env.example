# See docs/configuration.md for all supported settings, ranges and profiles.
# Default clone setup is local/offline. Existing credentials never enable a service.
DIPLOMACY_PROFILE=local
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173
DIPLOMACY_AUTH_CALLBACK_ORIGIN=http://localhost:3001
DIPLOMACY_AUTH_RETURN_ORIGIN=http://localhost:5173
# Defaults to ./data/diplomacy.sqlite locally and /data/diplomacy.sqlite in production.
# DIPLOMACY_DATABASE_PATH=./data/diplomacy.sqlite

# Server-owned AI policy. Real dispatch stays disabled until durable admission is
# implemented and explicitly enabled. Never put an API key in VITE_* settings.
DIPLOMACY_PAID_AI_ENABLED=false
LLM_MAX_GAME_COST_USD=1
LLM_TOTAL_BUDGET_USD=0
LLM_MAX_RETRIES=1
LLM_REQUEST_TIMEOUT_MS=30000
LLM_MAX_INPUT_TOKENS=16000
LLM_MAX_OUTPUT_TOKENS=2048
# Showcase fixes OPENAI to gpt-6-luna. Private/local profiles can configure:
# LLM_ALLOWED_PROVIDERS=STUB,OPENAI,GEMINI
# LLM_ALLOWED_MODELS_OPENAI=gpt-6-luna
# LLM_DEFAULT_OPENAI_MODEL=gpt-6-luna
# LLM_OPENAI_ORDERS_MODEL=gpt-6-luna
# OPENAI_API_KEY=

# Optional local opponents through Ollama (docs/local-ai.md). No key or paid switch.
# LLM_ALLOWED_PROVIDERS=STUB,OLLAMA
# LLM_ALLOWED_MODELS_OLLAMA=<a model you pulled>
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# GEMINI_API_KEY=

# Rules process limits (asynchronous enforcement in DIC-61).
DIPLOMACY_ENGINE_CONCURRENCY=2
DIPLOMACY_ENGINE_MAX_QUEUE=16
DIPLOMACY_ENGINE_TIMEOUT_MS=10000
DIPLOMACY_ENGINE_MAX_OUTPUT_BYTES=4194304
# DIPLOMACY_ENGINE_PATH=/absolute/path/to/diplomacy-engine

# OAuth player login. Configure either or both providers with a session secret.
# DIPLOMACY_GITHUB_CLIENT_ID=
# DIPLOMACY_GITHUB_CLIENT_SECRET=
# DIPLOMACY_GOOGLE_CLIENT_ID=
# DIPLOMACY_GOOGLE_CLIENT_SECRET=
# DIPLOMACY_AUTH_SESSION_SECRET=
# DIPLOMACY_ADMIN_GITHUB_USER_IDS=123456
# Optional new-install secret file: npm run generate:auth-env -- .env.auth.new
# DIPLOMACY_AUTH_ENABLED=true
# DIPLOMACY_AUTH_COOKIE_SECURE=true

# Whose address rate limits see. `none` uses the direct peer. Set `private` only when the app is
# reachable solely through your own reverse proxy on a private network (the Lightsail compose file).
DIPLOMACY_TRUSTED_PROXY=none

# Local development only: `mock` lets you play sponsored attempts against a deterministic stand-in
# that makes no provider call. Refused outside the local profile.
DIPLOMACY_LUNA_TRANSPORT=none
# Which pinned opponent contract sponsored attempts use: luna or haiku (docs/haiku-preset.md).
DIPLOMACY_SPONSORED_PRESET=luna
# Development only (docs/playtest.md). Refused outside the local profile on a loopback host.
# DIPLOMACY_DEV_LOGIN=true
# DIPLOMACY_PLAYTEST_OPPONENTS=AUSTRIA=haiku,GERMANY=haiku
# DIPLOMACY_PLAYTEST_CHAT=true
# DIPLOMACY_CHAT_MESSAGE_LIMIT=30

# Attempt lifecycle defaults, enforced by the challenge admission/persistence work.
DIPLOMACY_MAX_ACTIVE_ATTEMPTS=3
DIPLOMACY_MAX_ACTIVE_PER_ACCOUNT=1
DIPLOMACY_DAILY_START_LIMIT=3
DIPLOMACY_IDLE_WARN_MINUTES=25
DIPLOMACY_IDLE_EXPIRE_MINUTES=30
DIPLOMACY_RESULT_RETENTION_DAYS=30
DIPLOMACY_DIAGNOSTIC_RETENTION_DAYS=7
DIPLOMACY_RECEIPT_RETENTION_DAYS=90

# Notifications never send during default local development.
DIPLOMACY_NOTIFY_MODE=outbox
# RESEND_API_KEY=
# DIPLOMACY_NOTIFY_FROM=Game <notifications@notify.example.com>
# DIPLOMACY_NOTIFY_TO=owner@example.com

# Optional private/local integrations. Showcase rejects enabling either.
DISCORD_ENABLED=false
DISCORD_VOICE_ENABLED=false
DISCORD_VOICE_DEBUG=false
DISCORD_VOICE_AUTO_LISTEN=true
# DISCORD_GUILD_ID=
# DISCORD_COORDINATOR_TOKEN=
# DISCORD_AUSTRIA_TOKEN=
# DISCORD_ENGLAND_TOKEN=
# DISCORD_FRANCE_TOKEN=
# DISCORD_GERMANY_TOKEN=
# DISCORD_ITALY_TOKEN=
# DISCORD_RUSSIA_TOKEN=
# DISCORD_TURKEY_TOKEN=

# Client-only origin override, not part of the server env renderer.
# VITE_SERVER_URL=http://localhost:3001
