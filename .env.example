# Node server
PORT=3001

# Site-wide password gate. In production, auth is enabled by default unless
# DIPLOMACY_AUTH_ENABLED=false is set. Generate values with:
# npm run generate:auth-env
# DIPLOMACY_AUTH_ENABLED=true
# DIPLOMACY_AUTH_USERNAME=shared-login-name
# DIPLOMACY_AUTH_PASSWORD_SALT=hex-salt
# DIPLOMACY_AUTH_PASSWORD_HASH=hex-scrypt-hash
# DIPLOMACY_AUTH_SESSION_SECRET=hex-session-secret
# Set this only if terminating TLS upstream but running NODE_ENV=production
# over local HTTP during a smoke test.
# DIPLOMACY_AUTH_COOKIE_SECURE=false

# Comma-separated browser origins allowed to use Socket.IO in development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional override for the compiled rules-engine executable.
# DIPLOMACY_ENGINE_PATH=/absolute/path/to/diplomacy-engine

# Required only for LLM seats configured with the OPENAI provider.
# OPENAI_API_KEY=your-api-key

# Optional single-server Discord integration. The coordinator handles game
# binding and player linking. Each configured power token represents that
# power's distinct Discord identity.
# DISCORD_GUILD_ID=your-discord-server-id
# DISCORD_COORDINATOR_TOKEN=coordinator-bot-token
# DISCORD_AUSTRIA_TOKEN=austria-bot-token
# DISCORD_ENGLAND_TOKEN=england-bot-token
# DISCORD_FRANCE_TOKEN=france-bot-token
# DISCORD_GERMANY_TOKEN=germany-bot-token
# DISCORD_ITALY_TOKEN=italy-bot-token
# DISCORD_RUSSIA_TOKEN=russia-bot-token
# DISCORD_TURKEY_TOKEN=turkey-bot-token

# Voice is separately gated while Discord audio receive is validated locally.
# Requires OPENAI_API_KEY and at least one configured power bot.
DISCORD_VOICE_ENABLED=false
DISCORD_VOICE_DEBUG=false
DISCORD_VOICE_AUTO_LISTEN=true

# Optional client override. Leave unset when client and server share an origin.
# VITE_SERVER_URL=http://localhost:3001
